{
  "name": "@hydra/liquid-staking-contract",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "private": true,
  "scripts": {
    "compact": "compact compile ./src/hydra-stake-protocol.compact ./src/managed/hydra-stake-protocol",
    "test-compact": "compact compile --skip-zk ./src/hydra-stake-protocol.compact ./src/managed/hydra-stake-protocol",
    "test": "vitest run src/tests/night-staking.test.ts",
    "build": "bun run compact && rm -rf dist && tsc --project tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/hydra-stake-protocol.compact ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'No lint config for @hydra/staking-contract'"
  }
}

