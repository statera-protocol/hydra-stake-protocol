{
  "name": "@night/night-staking-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "docker compose up -d && tsx watch ./src/index.ts",
    "start": "node --experimental-specifier-resolution=node dist/index.js",
    "jwt-key": "echo JWT_SECRET=$(node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\")",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'No lint config for @night/night-staking-api'"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fp-ts": "^2.16.11",
    "helmet": "^8.1.0",
    "io-ts": "^2.2.22",
    "mongodb": "^7.1.0",
    "mongoose": "^9.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mongodb": "^4.0.7",
    "@hydra/night-staking-contract": "workspace:*",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^24.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
